# Copy to .env and fill in values. Never commit .env (gitignored).

# ── dbt MCP (local) ───────────────────────────────────────────────────────────
# Path to folder containing dbt_project.yml (update after dbt init)
DBT_PROJECT_DIR=.
# DBT_PATH=/full/path/to/dbt  # optional if dbt not on PATH

# Optional: dbt Cloud platform API (Discovery, Semantic Layer)
# DBT_HOST=https://your-subdomain.us1.dbt.com
# DBT_TOKEN=dbt_...
# DBT_ACCOUNT_ID=
# DBT_PROD_ENV_ID=

# ── Databricks MCP ────────────────────────────────────────────────────────────
# Alternative to VS Code input prompt — export before launching VS Code
# DATABRICKS_PAT=dapi...

# Databricks CLI profile (for bundle deploy / databricks skill)
# DATABRICKS_CONFIG_PROFILE=DEFAULT
